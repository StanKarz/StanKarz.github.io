---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Hand-maintained: a project earns a line here when it's something to use, not just read.
// Newest first. `date` is when it was essentially done, not when it was started.
const projects = [
  {
    href: '/projects/sql/',
    title: 'SQL reference',
    date: 'October 2026',
    summary: 'Joins, NULLs, grouping and window functions, with interactives and the mistakes behind them.',
  },
  {
    href: '/projects/mission-control/',
    title: 'Mission control',
    date: 'August 2026',
    summary:
      'A terminal dashboard for several projects at once, where the progress bar is computed from predicates rather than ticked by hand.',
  },
];
---

<BaseLayout title="Projects" description="Tools, interactive references and other related things I've built.">
  <h1 class="heading">Projects</h1>
  <p class="intro">Tools, interactive references and other related things I've built.</p>
  <ul class="list">
    {projects.map((p) => (
      <li>
        <a href={p.href}>
          <span class="row">
            <span class="title">{p.title}</span>
            <span class="date">{p.date}</span>
          </span>
          <span class="summary">{p.summary}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .heading {
    font-size: var(--font-size-2xl);
    letter-spacing: var(--letter-spacing-tight);
  }

  .intro {
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
  }

  .list {
    list-style: none;
    margin-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .list a {
    display: block;
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
  }

  .list a:hover .title {
    color: var(--color-accent);
  }

  /* Title and date on one line, the date pushed to the right margin. */
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .title {
    font-weight: 600;
    transition: var(--transition-color);
  }

  .date {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .summary {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
</style>
