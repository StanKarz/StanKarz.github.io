---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Hand-maintained: a project earns a line here when it's something to use, not just read.
const projects = [
  {
    href: '/projects/sql/',
    title: 'SQL reference',
    summary: 'Joins, NULLs, grouping and window functions, with interactives and the mistakes behind them.',
  },
];
---

<BaseLayout title="Projects · Stan Karzhev" description="Tools, interactive references and other related things I've built.">
  <h1 class="heading">Projects</h1>
  <p class="intro">Tools, interactive references and other related things I've built.</p>
  <ul class="list">
    {projects.map((p) => (
      <li>
        <a href={p.href}>
          <span class="title">{p.title}</span>
          <span class="summary">{p.summary}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .heading {
    font-size: var(--font-size-2xl);
    letter-spacing: var(--letter-spacing-tight);
  }

  .intro {
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
  }

  .list {
    list-style: none;
    margin-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .list a {
    display: block;
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
  }

  .list a:hover .title {
    color: var(--color-accent);
  }

  .title {
    display: block;
    font-weight: 600;
    transition: var(--transition-color);
  }

  .summary {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
</style>
