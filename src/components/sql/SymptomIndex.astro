---
import { mistakes, SYMPTOMS, type Symptom } from '../../data/sql/mistakes';
import styles from './SymptomIndex.module.css';

const order: Symptom[] = ['error', 'no-rows', 'extra-rows', 'wrong-rows', 'wrong-numbers'];
---

<div class={styles.index}>
  {order.map((s) => (
    <section class={styles.group} id={`symptom-${s}`}>
      <h3 class={styles.title}>{SYMPTOMS[s].title}</h3>
      <p class={styles.hint}>{SYMPTOMS[s].hint}</p>
      <ul class={styles.list}>
        {mistakes
          .filter((m) => m.symptom === s)
          .map((m) => (
            <li>
              <a href={`#mistake-${m.id}`} data-open-mistake>
                {m.error ? <code>{m.error}</code> : m.title}
              </a>
              <span class={styles.section}>{m.section.replace(/-/g, ' ')}</span>
            </li>
          ))}
      </ul>
    </section>
  ))}
</div>
